# Gemini API Key (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_api_key_here

# Stage 1 — Audio transcription (Gemini). Defaults shown; all optional.
# Model for ASR + diarization. Falls back to GEMINI_MODEL, then gemini-3.6-flash.
#GEMINI_TRANSCRIBE_MODEL=gemini-3.6-flash
# Per-call timeout in seconds. Audio calls are far slower than text analysis.
#GEMINI_TRANSCRIBE_TIMEOUT_SECONDS=300
# Attempts per transcription. Transient capacity 503s fail fast, so 2 attempts
# cost little worst-case latency but recover most flaky failures.
#GEMINI_TRANSCRIBE_MAX_ATTEMPTS=2
# How long to wait for the Gemini Files API to finish processing >=18MB uploads.
#GEMINI_FILES_POLL_TIMEOUT_SECONDS=120

# Stage 2 — Liability analysis (Gemini). Also optional; see backend/analyzers/gemini_runtime.py.
# Model override for both analyzer stages.
#GEMINI_MODEL=gemini-3.6-flash
